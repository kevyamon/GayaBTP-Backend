# Environnement de déploiement (development | staging | production)
NODE_ENV=development

# Port d'écoute du serveur HTTP
PORT=5000

# URL du frontend (redirections de paiement et CORS)
FRONTEND_URL=http://localhost:5173

# Chaîne de connexion MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gayabtp?retryWrites=true&w=majority

# Secrets JWT pour l'authentification (générez avec openssl rand -base64 64)
JWT_ACCESS_SECRET=votre_cle_secrete_access_token_tres_longue_et_aleatoire
JWT_REFRESH_SECRET=votre_cle_secrete_refresh_token_tres_longue_et_aleatoire
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Origines CORS autorisées (séparées par des virgules)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Passerelle de Paiement Genius Pay (Mobile Money Wave, MoMo, Orange, CB)
GENIUS_PAY_API_KEY=votre_cle_publique_ou_privee_genius_pay
GENIUS_PAY_SECRET_KEY=votre_cle_secrete_genius_pay
GENIUS_PAY_WEBHOOK_SECRET=votre_secret_webhook_pour_signature_hmac
GENIUS_PAY_BASE_URL=https://api.geniuspay.ci

# Stockage sécurisé des médias et documents (Cloudinary)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# Authentification Google OAuth (Optionnel)
GOOGLE_CLIENT_ID=votre_google_client_id.apps.googleusercontent.com

# Service E-mails Transactionnels (Brevo REST HTTPS Port 443)
BREVO_API_KEY=xkeysib-votre_cle_api_brevo
EMAIL_FROM=contactgayabtp@gmail.com
EMAIL_FROM_NAME=GayaBTP
ADMIN_EMAIL=admin@gayabtp.com
