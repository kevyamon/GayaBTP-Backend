# Environnement de deploiement (development | staging | production)
NODE_ENV=development

# Port d'ecoute du serveur HTTP
PORT=5000

# Chaine de connexion MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gayabtp?retryWrites=true&w=majority

# Secrets JWT pour l'authentification
# Generez des cles solides (ex: openssl rand -base64 64)
JWT_ACCESS_SECRET=votre_cle_secrete_access_token_tres_longue_et_aleatoire
JWT_REFRESH_SECRET=votre_cle_secrete_refresh_token_tres_longue_et_aleatoire
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Origines CORS autorisees (separees par des virgules)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Stockage securise des medias et documents (Cloudinary)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# Authentification Google OAuth (Optionnel en developpement initial)
GOOGLE_CLIENT_ID=votre_google_client_id.apps.googleusercontent.com

# Mode commercial de la plateforme (free | paid)
COMMERCIAL_MODE=free
